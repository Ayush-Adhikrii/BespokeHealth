# Copy this file to `.env` in the same folder if you need to override any
# defaults. `.env` is gitignored and must NEVER be committed. Vite only
# exposes variables prefixed with VITE_ to browser code -- anything else
# in a frontend .env would silently be invisible to import.meta.env.

# Base URL of the backend API. Only needs setting if the backend isn't
# running at the default local address (e.g. a different port, a
# container, or a real deployed backend). Falls back to
# https://localhost:3000/api if unset (see src/context/AuthContext.jsx).
VITE_API_URL=https://localhost:3000/api
