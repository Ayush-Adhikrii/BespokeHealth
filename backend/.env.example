# Copy this file to `.env` in the same folder and fill in real values.
# `.env` itself is gitignored and must NEVER be committed -- this file
# (`.env.example`) is the safe, committed record of which variables the
# app needs and what they're for. Keep it in sync whenever you add,
# rename, or remove a variable the code actually reads.

# Port the Express server listens on.
PORT=3000

# PostgreSQL connection string, read by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:password@localhost:5432/bespoke_health"

# Secret used to sign and verify JWT auth tokens. Must be a long, random,
# unguessable string -- generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the same value across dev / staging / production.
JWT_SECRET=

# Gmail address used to send verification and password-reset emails.
EMAIL_USER=

# A Gmail App Password (NOT your normal Gmail password). Requires 2-Step
# Verification enabled on the Google account, then generate one at:
# https://myaccount.google.com/apppasswords
EMAIL_PASS=

# Khalti merchant secret key (server-side only), from the Khalti
# merchant dashboard. Use a test/sandbox key for local development.
KHALTI_SECRET_KEY=

# Base URL of the frontend app. Used for CORS, links in outgoing emails,
# and as the Khalti payment return_url.
FRONTEND_URL=https://localhost:5173

# Google reCAPTCHA v2 secret key (server-side verification), from
# https://www.google.com/recaptcha/admin -- must be the *secret* key,
# paired with the public *site* key hardcoded in SignupPage.jsx.
RECAPTCHA_SECRET_KEY=

# 32-byte key used to AES-256-CBC encrypt chat messages (backend/utils/encryption.js).
# Not currently wired into any active code path, but required if that
# feature is ever turned on -- must be EXACTLY 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CHAT_ENCRYPTION_KEY=
